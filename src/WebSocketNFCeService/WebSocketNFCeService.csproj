<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AZFoodWebSocketNFCe</AssemblyName>
    <UserSecretsId>dotnet-WebSocketNFCeService-6272357d-c887-4938-8137-67d0fdfa0054</UserSecretsId>
    <NoWarn>CA1416</NoWarn>
      <!-- Versao do servico. E ela que sai no /health e no /health-nfe, e e como o
         AZFood sabe o que a maquina do restaurante suporta. Subir aqui ao mudar
         o contrato do payload. 1.1 = NF-e modelo 55 + transp/cobr/infAdic/rastro.
         1.2 = IE do destinatario (inscricaoEstadual) + nome em branco omitido. -->
    <Version>1.3.0</Version>
</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebSocketNFCeService.Domain\WebSocketNFCeService.Domain.csproj" />
    <ProjectReference Include="..\WebSocketNFCeService.Infra\WebSocketNFCeService.Infra.csproj" />
    <ProjectReference Include="..\WebSocketNFCeService.NFe\WebSocketNFCeService.NFe.csproj" />
  </ItemGroup>
</Project>
